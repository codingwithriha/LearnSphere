PORT=8000
DB_URI=mongodb://127.0.0.1:27017/lms-portal
ORIGIN=http://localhost:3000

# JWT
ACCESS_TOKEN=your_access_token_secret_change_me
REFRESH_TOKEN=your_refresh_token_secret_change_me
ACCESS_TOKEN_EXPIRE=5
REFRESH_TOKEN_EXPIRE=3

# Account activation
ACTIVATION_SECRET=your_activation_secret_change_me

# Cloudinary (required for course thumbnails)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_SECRET_KEY=your_cloud_secret_key

# Email (required for registration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Stripe (required for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Redis (optional — uses in-memory cache if not set)
# REDIS_URL=redis://127.0.0.1:6379

NODE_ENV=development
